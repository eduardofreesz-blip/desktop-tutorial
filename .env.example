# ============================================
# Universal Recargas - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# --- Banco de Dados (PostgreSQL) ---
DATABASE_URL='postgresql://universal_user:SUA_SENHA_AQUI@localhost:5432/universal_recargas'

# --- NextAuth ---
NEXTAUTH_SECRET=gere_um_secret_com_openssl_rand_base64_32
NEXTAUTH_URL=https://seu-dominio.com.br

# --- Getnet (Gateway de Pagamento) ---
GETNET_ENVIRONMENT=production
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_SELLER_ID=

# --- PagSeguro ---
PAGSEGURO_TOKEN=
PAGSEGURO_EMAIL=
PAGSEGURO_ENVIRONMENT=production

# --- WhatsApp (API Oficial) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- WhatsApp (Baileys - Conexão Direta) ---
WA_PROXY_URL=
WA_SESSION_DIR=./storage/wa-session
WA_LOG_LEVEL=info

# --- Configurações do Servidor ---
WS_NO_BUFFER_UTIL=1
NODE_ENV=production
PORT=3005
