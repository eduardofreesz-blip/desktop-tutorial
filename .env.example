# ============================================================
# Universal Recargas — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ── Banco de Dados ───────────────────────────────────────────
DATABASE_URL='postgresql://universal_user:SUA_SENHA_AQUI@localhost:5432/universal_recargas'

# ── NextAuth ─────────────────────────────────────────────────
# Gere um segredo forte: openssl rand -base64 32
NEXTAUTH_SECRET=gere_um_secret_forte_aqui
# URL pública da sua aplicação (sem barra no final)
NEXTAUTH_URL=https://seudominio.com.br

# ── Porta e Ambiente ─────────────────────────────────────────
NODE_ENV=production
PORT=3005

# ── Getnet (Gateway de Pagamento) ────────────────────────────
GETNET_ENVIRONMENT=production
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_SELLER_ID=

# ── PagSeguro ────────────────────────────────────────────────
PAGSEGURO_TOKEN=
PAGSEGURO_EMAIL=
PAGSEGURO_ENVIRONMENT=production

# ── FitBank ──────────────────────────────────────────────────
FITBANK_ENVIRONMENT=production

# ── Itaú ─────────────────────────────────────────────────────
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
ITAU_CHAVE_PIX=
ITAU_ENVIRONMENT=production

# ── Sicoob ───────────────────────────────────────────────────
SICOOB_CLIENT_ID=
SICOOB_CLIENT_SECRET=
SICOOB_CHAVE_PIX=
SICOOB_ENVIRONMENT=production

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=universal_recargas_webhook_token

# ── WhatsApp Baileys ─────────────────────────────────────────
# Deixe vazio para não usar proxy
WA_PROXY_URL=
# Diretório de sessão Baileys (relativo ao projeto)
WA_SESSION_DIR=./storage/wa-session
# Diretório de credenciais Baileys
WA_AUTH_DIR=./wa_auth
WA_LOG_LEVEL=warn

# ── IA / LLM ─────────────────────────────────────────────────
ABACUSAI_API_KEY=

# ── AWS S3 ───────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=universal-recargas

# ── Notificações Admin ───────────────────────────────────────
# Números WhatsApp para notificações administrativas (separados por vírgula)
ADMIN_PHONES=

# ── Performance WebSocket ────────────────────────────────────
WS_NO_BUFFER_UTIL=1
