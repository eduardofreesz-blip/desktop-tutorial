# Copie para ".env" e ajuste os valores.
#
# Para Docker Compose (recomendado), use:
# DATABASE_URL=postgresql://universal_user:<SENHA>@db:5432/universal_recargas

NODE_ENV=production
PORT=3005

NEXTAUTH_URL=https://SEU_DOMINIO.com
NEXTAUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Banco (use "db" como host quando estiver no docker-compose)
DATABASE_URL=postgresql://universal_user:CHANGE_ME@db:5432/universal_recargas

# Docker Compose Postgres (opcional; usado pelo serviço "db")
POSTGRES_USER=universal_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=universal_recargas

# WhatsApp / Baileys (persistir em volume no Docker)
WA_AUTH_DIR=/data/wa_auth
WA_PROXY_URL=
WA_LOG_LEVEL=info
WS_NO_BUFFER_UTIL=1

# Integrações (preencha se usar)
GETNET_ENVIRONMENT=production
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_SELLER_ID=

PAGSEGURO_ENVIRONMENT=sandbox
PAGSEGURO_TOKEN=
PAGSEGURO_EMAIL=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
